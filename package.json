    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:parity": "tsx scripts/parity.ts",
    "test:s1": "tsx scripts/s1-config.ts",
    "test:s2": "tsx scripts/s2-fagll03.ts",
    "test:a0": "tsx scripts/a0-expected.ts && tsx scripts/a0-ids.ts && tsx scripts/a0-ckmlcp.ts && tsx scripts/a01-identity-events.ts",
    "test:s3": "tsx scripts/s3-reports.ts",
    "test:health": "tsx scripts/s1-health.ts",
    "lint:eslint": "eslint .",
    "lint:eslint:strict": "eslint src/reports src/events src/pages/ReportsPage.tsx scripts/s3-reports.ts scripts/s1-health.ts eslint.config.js"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
